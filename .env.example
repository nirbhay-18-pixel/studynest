# ---------- Supabase (cloud persistence & auth — optional, local-first by default) ----------
# Client-safe keys only. Never commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER-ONLY — never prefix with VITE_, never ship to the browser (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI Assistant ----------
# OpenAI-compatible chat/completions endpoint. In production, point this at your
# own serverless proxy (e.g. /api/ai/chat) that holds the real key server-side.
VITE_AI_ENDPOINT=
VITE_AI_MODEL=gpt-4o-mini
VITE_AI_API_KEY=
